# Copy to .env and adjust for your environment.

ENVIRONMENT=development

# Generate a strong key for production: openssl rand -hex 32
SECRET_KEY=dev-secret-change-me-in-production

# Token lifetimes
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
PASSWORD_RESET_EXPIRE_MINUTES=30

# Database
# SQLite (default, zero-setup):
DATABASE_URL=sqlite+aiosqlite:///./teamsync.db
# PostgreSQL (production) — uncomment and use with docker-compose:
# DATABASE_URL=postgresql+asyncpg://teamsync:teamsync@localhost:5432/teamsync

# Refresh-token cookie (set COOKIE_SECURE=true behind HTTPS)
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# Frontend / CORS
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000
